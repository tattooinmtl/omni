// Omni settings template.
//
// Omni generates a real settings.json on first run inside its home dir
// (<install>/agent/settings.json, or %OMNI_HOME%/settings.json). That file
// is git-ignored and holds YOUR keys — never commit it.
//
// To use this template: copy it to that location and fill in your keys, OR just
// run Omni once and set keys from the REPL with `/apikey <provider> <key>`.
// Only whole-line `//` comments are supported. Keys may also come from
// environment variables (OMNI_<PROVIDER>_KEY), which override the file.
{
  "defaultProvider": "nvidia",
  "defaultModel": "nvidia/nemotron-3-ultra-550b-a55b",
  "reasoning": "medium",
  "maxToolIterations": 30,
  "diffPreview": true,

  // Each provider is an OpenAI-compatible /chat/completions endpoint.
  // Leave apiKey "" and set it later; "not-needed" marks a keyless local server.
  "providers": {
    // free key: https://build.nvidia.com
    "nvidia": {
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKey": "",
      "api": "openai-completions",
      "nativeTools": false
    },
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": ""
    },
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "",
      "reasoningParam": "none"
    },
    "groq": {
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKey": "",
      "reasoningParam": "none"
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": ""
    },
    "google": {
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKey": ""
    },
    "xai": {
      "baseUrl": "https://api.x.ai/v1",
      "apiKey": ""
    },
    "mistral": {
      "baseUrl": "https://api.mistral.ai/v1",
      "apiKey": "",
      "reasoningParam": "none"
    },
    "ollama": {
      "baseUrl": "http://localhost:11434/v1",
      "apiKey": "not-needed",
      "reasoningParam": "none"
    },
    // bundled llama.cpp server — no key required
    "local": {
      "baseUrl": "http://localhost:8080/v1",
      "apiKey": "not-needed",
      "reasoningParam": "none"
    },
    // Agnes AI — get key from https://apihub.agnes-ai.com
    "agnes": {
      "baseUrl": "https://apihub.agnes-ai.com/v1",
      "apiKey": ""
    },
    // xKiro — unified gateway, OpenAI-compatible. Free tier: 5M tokens/day
    // across 11 free-priced models (Mistral family, GPT-5.3 Codex Spark,
    // SenseNova 6.7/6.8 flash-lite). Sign up at https://xkiro.com/dashboard.
    "xkiro": {
      "baseUrl": "https://api.xkiro.com/v1",
      "apiKey": "",
      "reasoningParam": "none"
    }
  },

  // Model catalog: <key> -> { provider, id, maxTokens }. Switch with /model <key>.
  // maxTokens is the OUTPUT cap per response (sent as max_tokens).
  // The context window is auto-detected (provider metadata, then a known-family
  // table); pin it explicitly with "contextWindow": 202752 or the /context command.
  "models": {
    "nvidia/nemotron-3-ultra-550b-a55b": { "provider": "nvidia", "id": "nvidia/nemotron-3-ultra-550b-a55b", "maxTokens": 16384 },
    "nvidia/glm-5.2":       { "provider": "nvidia",     "id": "z-ai/glm-5.2",                "maxTokens": 16384 },
    "nvidia/llama-3.3-70b": { "provider": "nvidia",     "id": "meta/llama-3.3-70b-instruct", "maxTokens": 4096 },
    "openai/gpt-4.1":       { "provider": "openai",     "id": "gpt-4.1",                     "maxTokens": 16384 },
    "openai/o4-mini":       { "provider": "openai",     "id": "o4-mini",                     "maxTokens": 16384, "reasoning": true },
    "openrouter/sonnet":    { "provider": "openrouter", "id": "anthropic/claude-3.5-sonnet", "maxTokens": 8192 },
    "openrouter/llama-3-8b": { "provider": "openrouter", "id": "meta-llama/llama-3-8b-instruct:free", "maxTokens": 8192, "free": true },
    "openrouter/mistral-7b": { "provider": "openrouter", "id": "mistralai/mistral-7b-instruct:free", "maxTokens": 8192, "free": true },
    "openrouter/neural-8b": { "provider": "openrouter", "id": "undi95/toppy-m-7b:free", "maxTokens": 8192, "free": true },
    "agnes/2.5-flash":      { "provider": "agnes",      "id": "agnes-2.5-flash",            "maxTokens": 16384, "free": true },
    "agnes/2.5-pro-alpha":  { "provider": "agnes",      "id": "agnes-2.5-pro-alpha",        "maxTokens": 16384 },
    "agnes/2.0-flash":      { "provider": "agnes",      "id": "agnes-2.0-flash",            "maxTokens": 8192, "free": true },
    "xkiro/mistral-large":            { "provider": "xkiro", "id": "mistralai/mistral-large-2512",         "maxTokens": 16384, "free": true },
    "xkiro/mistral-medium-3.5":       { "provider": "xkiro", "id": "mistralai/mistral-medium-3.5",         "maxTokens": 16384, "free": true },
    "xkiro/mistral-small":            { "provider": "xkiro", "id": "mistralai/mistral-small-2603",         "maxTokens": 16384, "free": true },
    "xkiro/codestral":                { "provider": "xkiro", "id": "mistralai/codestral-2508",             "maxTokens": 16384, "free": true },
    "xkiro/devstral-medium":          { "provider": "xkiro", "id": "mistralai/devstral-medium",            "maxTokens": 16384, "free": true },
    "xkiro/ministral-14b":            { "provider": "xkiro", "id": "mistralai/ministral-14b",              "maxTokens": 16384, "free": true },
    "xkiro/ministral-8b":             { "provider": "xkiro", "id": "mistralai/ministral-8b",               "maxTokens": 16384, "free": true },
    "xkiro/ministral-3b":             { "provider": "xkiro", "id": "mistralai/ministral-3b",               "maxTokens": 16384, "free": true },
    "xkiro/gpt-5.3-codex-spark":      { "provider": "xkiro", "id": "openai/gpt-5.3-codex-spark",           "maxTokens": 16384, "free": true },
    "xkiro/sensenova-6.8-flash-lite": { "provider": "xkiro", "id": "sensenova/sensenova-6.8-flash-lite",   "maxTokens": 16384, "free": true },
    "xkiro/sensenova-6.7-flash-lite": { "provider": "xkiro", "id": "sensenova/sensenova-6.7-flash-lite",   "maxTokens": 16384, "free": true },
    "local/coder":          { "provider": "local",      "id": "your-model-name",             "maxTokens": 8192 }
  },

  // Local llama.cpp server (drives the "local" provider). Point modelsDir at your
  // own folder of .gguf files; manage with /llama list|start|stop|status.
  // binDir "" auto-detects <install>/server (or legacy <install>/llama). contextSize "auto" (or 0) loads the
  // model's full trained context from the GGUF header, capped at maxAutoContext
  // to bound RAM/VRAM. ngl is GPU layers (0 = CPU only, the safe default —
  // only raise it on a machine with a working GPU). defaultModel loads on
  // a bare /llama start.
  "llama": {
    "binDir": "",
    "modelsDir": "C:\\models",
    "host": "127.0.0.1",
    "port": 8080,
    "contextSize": "auto",
    "maxAutoContext": 131072,
    "ngl": 99,
    "defaultModel": "",
    "extraArgs": []
  }
}
