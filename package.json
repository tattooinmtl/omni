{
  "name": "omni-agent",
  "version": "2.2.3",
  "private": true,
  "type": "module",
  "description": "OMNI-AGENT - Omni-present harness for agents",
  "author": "Erik Boivin <erik.boivin@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tattooinmtl/omni#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tattooinmtl/omni.git"
  },
  "bugs": {
    "url": "https://github.com/tattooinmtl/omni/issues"
  },
  "bin": {
    "omni": "./bin/omni.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node ./bin/omni.mjs",
    "test": "node ./tests/run-all.mjs",
    "setup": "node ./scripts/setup.mjs",
    "setup:router": "node ./scripts/setup.mjs --with-router",
    "zip:source": "git archive --worktree-attributes --format=zip --output dist/omni-source.zip HEAD",
    "install:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install/install.ps1 -SkipLink",
    "install:update": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install/install.ps1 -AutoUpdate"
  }
}
