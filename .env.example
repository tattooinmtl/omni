# Omni environment template — copy to `.env` and fill in your own keys.
# The real `.env` is git-ignored and stays on your machine; this example is the
# only one committed. Keys are per-provider: OMNI_<PROVIDER>_KEY.
#
# Precedence: a non-empty key in settings.json (set with /apikey) WINS.
# Keys here only fill providers/accounts whose settings.json key is empty.
# A real shell environment variable beats this file.
# To switch a key to .env, clear it in settings.json first (/provider logout <name>).

# NVIDIA NIM (default provider) — free key at https://build.nvidia.com
OMNI_NVIDIA_KEY=

# Second NVIDIA account (optional). With both set, the agent fails over to the
# other account automatically when one gets rate-limited (429), and you can
# switch manually with /switch-provider nvidia1|nvidia2. OMNI_NVIDIA_KEY
# above seeds nvidia1 when OMNI_NVIDIA1_KEY is not set.
OMNI_NVIDIA1_KEY=
OMNI_NVIDIA2_KEY=

# Other OpenAI-compatible providers (only set the ones you use)
OMNI_OPENAI_KEY=
OMNI_OPENROUTER_KEY=

# Agnes AI — get key from https://apihub.agnes-ai.com
OMNI_AGNES_KEY=
# Optional Agnes account keys for agnes1/agnes2 failover chains.
# Preferred names:
OMNI_AGNES1_KEY=
OMNI_AGNES2_KEY=
# Back-compat alias supported by loader:
# OMNI_AGNES_KEY2=

# MiniMax — https://api.minimax.io (model: MiniMax-M3)
OMNI_MINIMAX_IO_KEY=
# Note: env vars are a fallback. A non-empty providers["minimax.io"].apiKey
# in settings.json wins on every load, so /apikey stays effective.

# Back-compat alias supported by loader (the separate "minimax" provider was
# folded into "minimax.io"; this still feeds it):
# OMNI_MINIMAX_KEY=

# Atria ASI — https://api.atria-asi.ai/v1 (model: Atria-Dawn-Preview)
OMNI_ATRIA_KEY=
# Atria's own docs tell you to export ATRIA_API_KEY; Omni accepts that name too
# (OMNI_ATRIA_KEY wins if both are set).
# ATRIA_API_KEY=

# OMNI_HOME (the config directory) can only be set as a real environment
# variable, not in this file.
