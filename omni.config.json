{
  "$schema": "./schema/omni.config.schema.json",
  "promptFile": "prompts/default.md",
  "theme": "themes/forge-yellow.json",
  "extensions": [
    "extensions/file-tools.js",
    "extensions/web-search.js",
    "extensions/browser-use.js"
  ],
  "skills": [
    "skills/code-review",
    "skills/project-doctor",
    "skills/html-game-builder",
    "skills/vs-project-starter",
    "skills/okf-knowledge"
  ],
  "autoDiscoverSkills": true,
  "registry": "https://globalwarningnetworks.com/repo",
  "mcpServers": {
    "okf": {
      "command": "node",
      "args": ["{{INSTALL_ROOT}}/packages/okf/server.mjs"],
      "directTools": true
    }
  },
  "mcp": {
    "idleTimeout": 10,
    "directTools": false
  },
  "router": {
    "enabled": true,
    "mode": "auto",
    "default": "coding",
    "python": {
      "interpreter": "python",
      "confidenceThreshold": 0.6,
      "timeoutMs": 150
    }
  },
  "bridge": {
    "enabled": false,
    "hermesRoot": "C:\\hermes-agent",
    "python": {
      "interpreter": "python"
    }
  }
}
