# User home: real settings (API keys), sessions, memory — never committed
agent/

# Secrets
.env
*.pem
*.key

# Vendored binaries (fetched by the installer, not committed)
vendor/
llama/
server/
*.gguf

# ML artifacts (regenerated by router/train.py)
router/model.pkl
router/.venv/

# Build / packaging output
dist/
node_modules/

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# Internal docs/notes/audits stay local — the public repo ships just the
# README plus whatever markdown the app actually reads at runtime:
# the system prompt, SKILL.md for autoDiscoverSkills (and its package-source
# copies under packages/), and each package's own README.
docs/
*.md
!/README.md
!prompts/**/*.md
!skills/**/*.md
!packages/**/SKILL.md
!packages/**/README.md

# Website is a separate deployable static site with its own git history —
# never tracked inside the app repo.
website/

# This repo's own rebrand-tracking todo list — not part of the shipped app.
omni-todos/

# Downloaded source of the standalone memory-galaxy web app — a separate
# project that happens to live in this folder, never part of the harness.
okf-memory-galaxy-source/

*.bak
*.bak?
*.backup

# Test artifacts (e.g. browser_screenshot output during regression runs)
*.png
evil.com.png
# User's live installation state (real settings, sessions, memory, atom log,
# update-check cache) — never committed. See src/core/config.mjs HOME = OMNI_HOME.
agent/
# Same for the legacy per-user install location.
omni-home/
